# 测试数据库配置示例
# 复制此文件为 .env 或设置环境变量
# 注意：这是真实测试数据库配置，用于集成测试

# 启用集成测试（设置为 true 启用真实数据库测试）
TEST_DB_ENABLED=true

# ============================================
# 默认测试数据库配置（用于 API 集成测试）
# ============================================
# 数据库类型: mysql, postgres, sqlite
TEST_DB_TYPE=postgres

# PostgreSQL 配置（默认）
TEST_DB_HOST=192.168.1.174
TEST_DB_PORT=5433
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres_password
TEST_DB_NAME=postgres_db

# MySQL 配置示例（可选）
# TEST_DB_TYPE=mysql
# TEST_DB_HOST=192.168.1.174
# TEST_DB_PORT=3306
# TEST_DB_USER=mysql_user
# TEST_DB_PASSWORD=mysql_password
# TEST_DB_NAME=mysql_db

# ============================================
# 数据库模块测试配置 (internal/database)
# ============================================

# MySQL 测试配置
TEST_MYSQL_HOST=192.168.1.174
TEST_MYSQL_PORT=3306
TEST_MYSQL_USER=mysql_user
TEST_MYSQL_PASSWORD=mysql_password
TEST_MYSQL_DATABASE=mysql_db
TEST_MYSQL_CHARSET=utf8mb4

# MariaDB 测试配置（使用 MySQL 测试函数，但端口不同）
TEST_MARIADB_HOST=192.168.1.174
TEST_MARIADB_PORT=3307
TEST_MARIADB_USER=mariadb_user
TEST_MARIADB_PASSWORD=mariadb_password
TEST_MARIADB_DATABASE=mariadb_db
TEST_MARIADB_CHARSET=utf8mb4

# PostgreSQL 测试配置
TEST_POSTGRES_HOST=192.168.1.174
TEST_POSTGRES_PORT=5433
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=postgres_password
TEST_POSTGRES_DATABASE=postgres_db
TEST_POSTGRES_SSLMODE=disable

# 达梦数据库测试配置
TEST_DAMENG_HOST=192.168.1.191
TEST_DAMENG_PORT=5236
TEST_DAMENG_USER=SYSDBA
TEST_DAMENG_PASSWORD=DMdba_123
TEST_DAMENG_DATABASE=SYSDBA
# 注意：达梦数据库配置为大小写敏感

# ============================================
# SQLite 配置示例（不需要连接信息）
# ============================================
# TEST_DB_TYPE=sqlite
# TEST_DB_NAME=test.db

