# 测试数据库配置示例
# 复制此文件为 .env 或设置环境变量

# 启用集成测试（设置为 true 启用真实数据库测试）
TEST_DB_ENABLED=true

# 数据库类型: mysql, postgres, sqlite
TEST_DB_TYPE=mysql

# MySQL/MariaDB 配置
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=your_password
TEST_DB_NAME=test_dbdatagenerator

# PostgreSQL 配置示例
# TEST_DB_TYPE=postgres
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=your_password
# TEST_DB_NAME=test_dbdatagenerator

# SQLite 配置示例（不需要连接信息）
# TEST_DB_TYPE=sqlite
# TEST_DB_NAME=test.db

